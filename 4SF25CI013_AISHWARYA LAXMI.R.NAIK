 "cells": [
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "d1f51af3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "All four text files created successfully!\n"
     ]
    }
   ],
   "source": [
    "\n",
    "# Creating the four text files\n",
    "\n",
    "with open(\"document.txt\", \"w\") as file:\n",
    "    file.write(\"Python is easy to learn. File handling is useful.\")\n",
    "\n",
    "with open(\"data.txt\", \"w\") as file:\n",
    "    file.write(\"hello world\\nhello Python\\nhello students\")\n",
    "\n",
    "with open(\"reverse.txt\", \"w\") as file:\n",
    "    file.write(\"Apple\\nBanana\\nMango\")\n",
    "\n",
    "with open(\"stats.txt\", \"w\") as file:\n",
    "    file.write(\"Hello world\\nPython is easy\")\n",
    "\n",
    "print(\"All four text files created successfully!\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d821881a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of words: 9\n"
     ]
    }
   ],
   "source": [
    "\n",
    "def count_words():\n",
    "    with open(\"document.txt\", \"r\") as file:\n",
    "        content = file.read()\n",
    "        words = content.split()\n",
    "        return len(words)\n",
    "\n",
    "print(\"Number of words:\", count_words())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "4b59d8ea",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Word replaced successfully!\n",
      "welcome world\n",
      "welcome Python\n",
      "welcome students\n"
     ]
    }
   ],
   "source": [
    "\n",
    "def replace_word(old_word, new_word):\n",
    "    with open(\"data.txt\", \"r\") as file:\n",
    "        content = file.read()\n",
    "\n",
    "    content = content.replace(old_word, new_word)\n",
    "\n",
    "    with open(\"data.txt\", \"w\") as file:\n",
    "        file.write(content)\n",
    "\n",
    "    print(\"Word replaced successfully!\")\n",
    "\n",
    "replace_word(\"hello\", \"welcome\")\n",
    "\n",
    "with open(\"data.txt\", \"r\") as file:\n",
    "    print(file.read())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2903c5c7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "MangoBanana\n",
      "Apple\n"
     ]
    }
   ],
   "source": [
    "\n",
    "def reverse_lines():\n",
    "    with open(\"reverse.txt\", \"r\") as file:\n",
    "        lines = file.readlines()\n",
    "\n",
    "    for line in reversed(lines):\n",
    "        print(line, end=\"\")\n",
    "\n",
    "reverse_lines()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "41b7dedf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Number of lines: 2\n",
      "Number of words: 5\n",
      "Number of characters: 26\n"
     ]
    }
   ],
   "source": [
    "\n",
    "def file_statistics():\n",
    "    with open(\"stats.txt\", \"r\") as file:\n",
    "        content = file.read()\n",
    "\n",
    "    lines = len(content.splitlines())\n",
    "    words = len(content.split())\n",
    "    characters = len(content)\n",
    "\n",
    "    return lines, words, characters\n",
    "\n",
    "lines, words, characters = file_statistics()\n",
    "\n",
    "print(\"Number of lines:\", lines)\n",
    "print(\"Number of words:\", words)\n",
    "print(\"Number of characters:\", characters)\n"
   ]
  },
